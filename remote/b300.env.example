# Copy to remote/b300.env and fill in. The non-example file is gitignored.
REMOTE_HOST=CHANGE_ME
REMOTE_USER=CHANGE_ME
REMOTE_PORT=22
# Simple absolute path or ~/relative/path; spaces are rejected.
REMOTE_ROOT='~/work/gemma4-fa4-kernels'
REMOTE_IDENTITY_FILE=
REMOTE_PROXY_JUMP=
REMOTE_EXTRA_SSH_ARGS=
EXPECTED_ARCH=sm_103
REMOTE_DESCRIPTION="B300 / Blackwell Ultra environment"
CUTE_DSL_ARCH=sm_103a
FLASH_ATTENTION_ARCH=sm_103
REMOTE_FA4_CACHE_DIR=

# Optional shell setup on the remote host before every command, for example:
# REMOTE_INIT_COMMAND='source /etc/profile && module purge && module load cuda/13.3'
REMOTE_INIT_COMMAND=:

# Optional scheduler/allocation wrapper. The helper appends `bash -lc <command>`.
# Example:
# REMOTE_LAUNCHER='srun --partition=blackwell --gres=gpu:b300:1 --time=01:00:00'
REMOTE_LAUNCHER=
