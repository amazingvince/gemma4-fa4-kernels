# Copy to remote/h100.env and fill in. The non-example file is gitignored.
REMOTE_HOST=CHANGE_ME
REMOTE_USER=CHANGE_ME
REMOTE_PORT=22
# Simple absolute path or ~/relative/path; spaces are rejected.
REMOTE_ROOT='~/work/gemma4-fa4-kernels'
REMOTE_IDENTITY_FILE=
REMOTE_PROXY_JUMP=
REMOTE_EXTRA_SSH_ARGS=
EXPECTED_ARCH=sm_90
REMOTE_DESCRIPTION="H100 / Hopper environment"
CUTE_DSL_ARCH=sm_90a
FLASH_ATTENTION_ARCH=sm_90
REMOTE_FA4_CACHE_DIR=

# Collision guard used by scripts/remote/gpu-run.sh. Keep a shared lock path
# for every task targeting this physical GPU.
REMOTE_GPU_LOCK_FILE=/tmp/gemma4-fa4-h100.gpu.lock
REMOTE_GPU_LOCK_WAIT_SECONDS=0
REMOTE_GPU_REQUIRE_IDLE=1

# Optional shell setup on the remote host before every command, for example:
# REMOTE_INIT_COMMAND='source /etc/profile && module purge && module load cuda/12.8'
REMOTE_INIT_COMMAND=:

# Optional scheduler/allocation wrapper. The helper appends `bash -lc <command>`.
# Example:
# REMOTE_LAUNCHER='srun --partition=gpu --gres=gpu:h100:1 --time=01:00:00'
REMOTE_LAUNCHER=
